<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_approval_wizard_form" model="ir.ui.view">
        <field name="name">sale.approval.wizard.form</field>
        <field name="model">sale.approval.wizard</field>
        <field name="arch" type="xml">
            <form string="Get Approval">
                <group>
                    <field name="user_id" options="{'no_create': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_confirm_approver" string="Send Request" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sale_approval_wizard" model="ir.actions.act_window">
        <field name="name">Get Approval</field>
        <field name="res_model">sale.approval.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
